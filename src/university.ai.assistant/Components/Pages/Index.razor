@page "/"
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@layout EmptyLayout

<div class="align-items-center justify-content-center">

    <section class="vh-100 gradient-custom">
        <div class="container py-5 h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                    <div class="card text-white" style="background-color: rgba(80, 80, 80, 0.8); border-radius: 1rem;">
                        <div class="card-body p-5 text-center">

                            <div>

                                <div class="mt-0 mb-2">
                                    <img src="/images/unibzeng.png" style="max-width: 150px;" />
                                </div>

                                <div class="mt-0 mb-5">
                                    <h3>AI Assistant</h3>
                                    <small class="text-white">
                                        Your smart university companion
                                    </small>
                                </div>
                               
                                <div class="input-group mb-4" style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">
                                    <span class="input-group-text border-0 bg-transparent text-white">
                                        <i class="fa-regular fa-envelope"></i>
                                    </span>
                                    <input type="email"
                                           class="form-control form-control-lg border-0 bg-transparent text-white"
                                           style="color:white;"
                                           @bind="email"
                                           placeholder="Email" />
                                </div>

                                <div class="input-group mb-5" style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">
                                    <span class="input-group-text border-0 bg-transparent text-white">
                                        <i class="fa-solid fa-lock"></i>
                                    </span>
                                    <input type="password"
                                           class="form-control form-control-lg border-0 bg-transparent text-white"
                                           style="color:white;"
                                           @bind="password"
                                           placeholder="Password" />
                                </div>


                                <button class="btn btn-blue btn-lg shadow signin-button mb-5"
                                        @onclick="NavigateToSignIn">
                                     Login
                                </button>

                             @*    <div class="d-flex justify-content-center text-center mt-4 pt-1">
                                    <a href="#!" class="text-white"><i class="fab fa-facebook-f fa-lg"></i></a>
                                    <a href="#!" class="text-white"><i class="fab fa-twitter fa-lg mx-4 px-2"></i></a>
                                    <a href="#!" class="text-white"><i class="fab fa-google fa-lg"></i></a>
                                </div> *@

                            </div>

                            <div>
                                <p class="mb-0">
                                    Don't have an account? 
                                </p>
                                <p>
                                    <a href="#!" class="text-white-50 fw-bold">Sign Up</a>
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <button class="btn btn-primary btn-lg shadow signin-button"
            @onclick="NavigateToSignIn">
        <i class="fa-solid fa-arrow-right-to-bracket" style="color: white;"></i> Anmelden
    </button>
</div>

<style>

    html, body {
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    body {
        margin: 0;
        padding: 0;
        background-image: url('/images/backgroundUni.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .signin-button {
        padding: 0.75rem 2.5rem;
        font-size: 1.2rem;
        border-radius: 10px;
        min-width: 250px;
    }

    input::placeholder {
        color: white !important;
        opacity: 1;
    }
</style>

@code {

    private string email = "";
    private string password = "";

    private void NavigateToSignIn()
    {
        if(email == "ridvan.plluzhina@gmail.com" && password == "12345")
        {
            Navigation.NavigateTo("/home");

        }
        else
        {
            Navigation.NavigateTo("/asdw");

        }
    }
}
