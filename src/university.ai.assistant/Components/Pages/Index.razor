@page "/"
@inject NavigationManager Navigation
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject NavigationManager Nav
@layout EmptyLayout
@using Microsoft.Extensions.Localization
@using university.ai.assistant.Resources
@inject IStringLocalizer<SharedResource> localizer
@using university.ai.assistant.Data
@inject IDbContextFactory<AppDbContext> DbFactory

<div class="align-items-center justify-content-center user-select-none">
    <section class="vh-100 gradient-custom">
        <div class="container h-100">
            <div class="row d-flex justify-content-center align-items-center h-100">
                <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                    <div class="card text-white" style="background-color: rgba(80, 80, 80, 0.8); border-radius: 1rem;">
                        <div class="card-body p-5 text-center">

                            <div>
                                <!-- Dropdown button, for selecting the language -->
                                <div class="dropdown align-content-end ms-2">
                                    <button class="btn btn-light dropdown-toggle focus-ring-0" style="height:50px;" type="button" data-bs-toggle="dropdown">
                                        <i class="fa-solid fa-globe"></i> @CurrentLanguage
                                    </button>

                                    <ul class="dropdown-menu" style="min-width:unset;width:120px;">
                                        <li>
                                            <button class="dropdown-item ms-0 me-0" @onclick='() => ChangeLanguage("en-US")'>
                                                <i class="fa-solid fa-globe"></i> @localizer["StrEnglish"]
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item ms-0 me-0" @onclick='() => ChangeLanguage("de-DE")'>
                                                <i class="fa-solid fa-globe"></i> @localizer["StrGerman"]
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item ms-0 me-0" @onclick='() => ChangeLanguage("it-IT")'>
                                                <i class="fa-solid fa-globe"></i> @localizer["StrItalian"]
                                            </button>
                                        </li>
                                    </ul>
                                </div>

                                <div class="mt-0 mb-2">
                                    <img src="/images/unibzeng.png" style="max-width: 150px;" />
                                </div>

                                <div class="mt-0 mb-5">
                                    <h3>@localizer["StrTitle"]</h3>
                                    <small class="text-white">
                                        @localizer["StrUnderTitle"]
                                    </small>
                                </div>

                                <!-- Error Message -->
                                @if (!string.IsNullOrEmpty(errorMessage))
                                {
                                    <div class="text-danger fw-bold mb-3">@errorMessage</div>
                                }
                               
                                <div class="input-group mb-4" style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">
                                    <span class="input-group-text border-0 bg-transparent text-white">
                                        <i class="fa-regular fa-envelope"></i>
                                    </span>
                                    <input type="email"
                                           class="form-control form-control-lg border-0 bg-transparent text-white"
                                           style="color:white;"
                                           @bind="email"
                                           @bind:event="oninput"
                                           placeholder="@localizer["StrEmail"]" />
                                </div>

                                <div class="input-group mb-5" style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">
                                    <span class="input-group-text border-0 bg-transparent text-white">
                                        <i class="fa-solid fa-lock"></i>
                                    </span>
                                    <input type="password"
                                           class="form-control form-control-lg border-0 bg-transparent text-white"
                                           style="color:white;"
                                           @bind="password"
                                           @bind:event="oninput"
                                           placeholder="@localizer["StrPassword"]" />
                                </div>


                                <button type="button" class="btn btn-success btn-lg shadow signin-button mb-4"
                                        @onclick="NavigateToSignIn">
                                     @localizer["StrLogin"]
                                </button>

                                <div class="d-flex justify-content-center text-center mb-3">
                                    <a href="https://www.facebook.com/engineering.unibz.it" class="text-white"><i class="fab fa-facebook-f fa-lg"></i></a>
                                    <a href="https://www.linkedin.com/school/faculty-of-engineering-free-university-of-bozen-bolzano/posts/?feedView=all" class="text-white"><i class="fab fa-linkedin fa-lg mx-4 px-2"></i></a>
                                    <a href="https://www.unibz.it/en/faculties/engineering/" class="text-white"><i class="fab fa-google fa-lg"></i></a>
                                </div>

                            </div>

                            <div>
                                <p class="mb-0">
                                    @localizer["StrNoAccount"]
                                </p>
                                
                                <button class="btn btn-blue rounded-3 text-white fw-bold" @onclick="SignUp">
                                    @localizer["StrSignUp"]
                                </button>                                
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<!-- Show Sign up dialog -->
@if (showSignUpDialog)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background-color: rgba(0,0,0,0.8);">

        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-white"
                 style="background-color: rgba(80, 80, 80, 0.8); border-radius: 1rem;">

                <div class="modal-header border-0">
                    <h5 class="modal-title">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i> @localizer["StrSignUp"]
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            @onclick="CloseDialog">
                    </button>
                </div>

                <div class="modal-body">

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(errorMessageModal))
                    {
                        <div class="text-danger text-center fw-bold mb-3">@errorMessageModal</div>
                    }

                    <!-- Email -->
                    <div class="input-group mb-4"
                         style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">

                        <span class="input-group-text border-0 bg-transparent text-white">
                            <i class="fa-regular fa-envelope"></i>
                        </span>

                        <input type="email"
                               class="form-control form-control-lg border-0 bg-transparent text-white"
                               style="color:white;"
                               @bind="newEmail"
                               @bind:event="oninput"
                               placeholder="@localizer["StrEmail"]" />
                    </div>

                    <!-- Password -->
                    <div class="input-group mb-3"
                         style="background-color: rgba(80, 80, 80, 1); border-radius: 1rem;">

                        <span class="input-group-text border-0 bg-transparent text-white">
                            <i class="fa-solid fa-lock"></i>
                        </span>

                        <input type="password"
                               class="form-control form-control-lg border-0 bg-transparent text-white"
                               style="color:white;"
                               @bind="newPassword"
                               @bind:event="oninput"
                               placeholder="@localizer["StrPassword"]" />
                    </div>
                </div>

                <div class="modal-footer border-0" >
                    <button type="button" class="btn btn-success text-white rounded-3" @onclick="CreateUser">
                        @localizer["StrSignUp"]
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (showSuccessModal)
{
    <div class="modal fade show d-block"
         tabindex="-1"
         role="dialog"
         style="background-color: rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-dialog-centered"
             role="document">

            <div class="modal-content">

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fa-regular fa-circle-check"></i> @localizer["StrSuccessTitle"]
                    </h5>
                </div>

                <div class="modal-body text-center">
                    <p>@localizer["StrSuccessText"]</p>
                </div>
            </div>
        </div>
    </div>
}



<style>

    html, body {
        height: 100%;
        margin: 0;
        overflow: hidden;
    }

    body {
        margin: 0;
        padding: 0;
        background-image: url('/images/backgroundUni.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        background-attachment: fixed;
    }

    .signin-button {
        padding: 0.75rem 2.5rem;
        font-size: 1.2rem;
        border-radius: 10px;
        min-width: 250px;
    }

    input::placeholder {
        color: white !important;
        opacity: 1;
    }

    input:focus,
.form-control:focus {
    outline: none !important;
    box-shadow: none !important;
}
</style>

@code {

    private string email = "";
    private string password = "";
    private string newEmail = "";
    private string newPassword = "";
    private string errorMessage = "";
    private string errorMessageModal = "";
    private bool showSignUpDialog = false;
    private bool showSuccessModal = false;


    private async Task NavigateToSignIn()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required.";
            return;
        }
        using var db = DbFactory.CreateDbContext();

        var user = await db.User
        .FirstOrDefaultAsync(u => u.Email == email && u.Password == password);

        if (user != null)
        {
            Nav.NavigateTo("/home");
        }
        else
        {
            errorMessage = "Invalid email or password.";
        }
    }

    public string CurrentCulture => CultureInfo.CurrentUICulture.Name;

    public string CurrentLanguage => CurrentCulture switch
    {
        "en-US" => localizer["StrEnglish"],
        "de-DE" => localizer["StrGerman"],
        "it-IT" => localizer["StrItalian"],
        _ => localizer["StrEnglish"]
    };

    // Method to change the language after the button is pressed
    public void ChangeLanguage(string culture)
    {
        var uri = new Uri(Nav.Uri);
        Nav.NavigateTo($"/set-culture?culture={culture}&redirectUri={Uri.EscapeDataString(uri.PathAndQuery)}", forceLoad: true
        );
    }

    private void SignUp()
    {
        showSignUpDialog = true;
    }

    private void CloseDialog()
    {
        showSignUpDialog = false;
        errorMessageModal = "";
    }

    // Method used to create a new user
    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newEmail) ||
            string.IsNullOrWhiteSpace(newPassword))
        {
            errorMessageModal = "Email and password are required.";
            return;
        }

        using var db = DbFactory.CreateDbContext();

        var existingUser = await db.User
            .FirstOrDefaultAsync(u => u.Email == newEmail);

        if (existingUser != null)
        {
            errorMessageModal = "User already exists.";
            return;
        }

        var user = new User
        {
            Email = newEmail,
            Password = newPassword
        };

        db.User.Add(user);
        await db.SaveChangesAsync();

        showSignUpDialog = false;

        newEmail = "";
        newPassword = "";

        errorMessageModal = "";

        showSuccessModal = true;
        StateHasChanged();

        await Task.Delay(2000);

        showSuccessModal = false;
        StateHasChanged();
    }
}
